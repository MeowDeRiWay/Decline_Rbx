local Rules = require("../src/shared/TownRules")
assert(Rules.ValidID(123) and not Rules.ValidID(0) and not Rules.ValidID(-1))
assert(not Rules.ValidID(0/0) and not Rules.ValidID(math.huge) and not Rules.ValidID(1.5) and not Rules.ValidID("123"))
assert(not Rules.Removed(0,0) and not Rules.Removed(3,3) and not Rules.Removed(4,2))
assert(Rules.Removed(2,3))
local owners = Rules.ParseOwners("23,17,23")
assert(owners[23] and owners[17] and Rules.SerializeOwners(owners) == "17,23")
assert(Rules.ParseOwners(17)[17] and not next(Rules.ParseOwners(nil)))
assert(Rules.Relation("Neutral","Ally") == "Pending")
assert(Rules.Relation("War","Neutral") == "Neutral")
print("PASS: town IDs, anonymous vote majority/ties, co-owner attribute roundtrip, alliance consent")
